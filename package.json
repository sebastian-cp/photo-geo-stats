{
  "name": "photo-geo-stats",
  "version": "0.1.0",
  "private": true,
  "description": "Mapa y estadísticas de tus fotos a partir de su EXIF, 100% en el navegador.",
  "author": "Sebastián Cofré",
  "license": "MIT",
  "repository": "github:sebastian-cp/photo-geo-stats",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:samples": "node scripts/fetch-samples.mjs && node scripts/make-floaters.mjs",
    "data:cities": "node scripts/build-cities.mjs"
  },
  "dependencies": {
    "@rapideditor/country-coder": "^5.6.1",
    "exifr": "^7.1.3",
    "maplibre-gl": "^5.6.1",
    "modern-screenshot": "^4.7.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
